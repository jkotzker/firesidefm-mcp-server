{
  "name": "firesidefm-mcp-server",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the Fireside.fm podcast hosting API",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fireside",
    "podcast"
  ],
  "license": "MIT",
  "author": "Joseph Kotzker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkotzker/firesidefm-mcp-server.git"
  },
  "homepage": "https://github.com/jkotzker/firesidefm-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/jkotzker/firesidefm-mcp-server/issues"
  },
  "type": "module",
  "mcpName": "io.github.jkotzker/firesidefm-mcp-server",
  "bin": {
    "firesidefm-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "dev": "tsx src/cli.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
